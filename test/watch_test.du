// Test datastore.watch() with concurrent watchers
// Tests: event emission, multiple subscribers, event data delivery

print("=== Datastore Watch Test ===")

store = datastore("watch_test")

print("Spawning 3 concurrent watchers...")
spawn("watch_watcher.du")
spawn("watch_watcher.du")
spawn("watch_watcher.du")

sleep(0.5)  // Let watchers start and connect

print("Setting user:1...")
store.set("user:1", {name = "Alice", role = "user"})
sleep(1)

print("Setting user:2...")
store.set("user:2", {name = "Bob", role = "user"})
sleep(1)

print("Updating user:1...")
store.update("user:1", {role = "admin"})
sleep(1)

print("Expiring user:2 (TTL=1s)...")
store.expire("user:2", 1)
sleep(2)  // Wait for sweep + watchers to process

print("Deleting user:1...")
store.delete("user:1")
sleep(1)

print("Waiting for all watchers to finish...")
sleep(2)

print("✓ Test complete")
