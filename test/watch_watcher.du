// Watcher worker script - monitors datastore events
// Spawned by watch_test.du

store = datastore("watch_test")

print("[watcher] started")

// watch() blocks until the next matching event actually happens - no timeout
count = 0
while true do
  event = store.watch(["set", "update", "delete", "expire"])
  msg = "[watcher] " + event.event + " " + event.key
  if event.data then
    msg = msg + " -> " + event.data
  end
  count = count + 1
  print(msg + " (#" + count + ")")
end
