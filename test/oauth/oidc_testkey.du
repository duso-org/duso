// TEST ONLY -- the throwaway keypair the fake OIDC provider signs with.
// Generated by make_test_key.sh; both files are gitignored. This key signs
// nothing real, and must never be used outside these tests.

if not file_exists("oidc_test_key.pem") then
  throw("oauth tests need a signing key -- run test/oauth/make_test_key.sh first")
end

return {
  private_key = load("oidc_test_key.pem"),
  kid = "test-key-1",
  jwk = parse_json(load("oidc_test_key.jwk.json"))
}
