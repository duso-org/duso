ctx = context()
base = datastore("fake_oidc_config").get("base")
ctx.response().json({
  issuer = base,
  authorization_endpoint = base + "/authorize",
  token_endpoint = base + "/token",
  jwks_uri = base + "/jwks",
  userinfo_endpoint = base + "/userinfo",
  id_token_signing_alg_values_supported = ["RS256"]
})
