// Run the oauth module tests
//
// These start fake providers on ports 8811 (GitHub) and 8812 (OIDC), so they are
// kept out of test/run_all_tests.du.

// The OIDC provider signs with a generated throwaway key (gitignored)
if not file_exists("oidc_test_key.pem") then
  throw("missing signing key -- run test/oauth/make_test_key.sh first")
end

tests = [
  "test_oauth_helpers.du",
  "test_oauth_callback.du",
  "test_oauth_github.du",
  "test_oauth_oidc.du",
  "test_oauth_google.du",
]

passed = 0
failed = 0

for test in tests do
  try
    run(test)
    passed = passed + 1
  catch (err)
    print("✗ " + test + " failed: " + err)
    failed = failed + 1
  end
end

print("")
print("OAuth Test Results: " + passed + " passed, " + failed + " failed")

if failed > 0 then
  exit(1)
end
