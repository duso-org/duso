// Benchmark: test get/set/select operations on loaded datastore
// Usage: duso test/bench_datastore.du -config 'size=10000,encrypted=false'

config = sys("-config") or {}
size = config.size or 100000
encrypted = config.encrypted
persist = config.persist  // nil = use gob, false = skip persist
wal = config.wal          // nil = use WAL, false = skip WAL

key_bytes = "0123456789abcdef0123456789abcdef"
key_b64 = encode_base64(key_bytes)

// Build datastore config matching creation
ds_config = {
  wal_sync_interval = 1,
  persist_interval = 30
}

snap_path = "/tmp/loadtest.dusnap"
wal_path = "/tmp/loadtest.duwal"

if persist != false then
  ds_config.persist = snap_path
end

if wal != false then
  ds_config.wal = wal_path
end

if encrypted then
  ds_config.encrypt_key = key_b64
end

print("Initializing datastore...")
init_start = timer()

// A datastore is configured exactly once. With no persistence there is nothing
// to load from disk, so create_datastore.du runs this script in its own process
// and the store is already configured — open it by name. Otherwise this is a
// fresh process and configuring it here is what triggers recovery.
if persist == false and wal == false then
  store = datastore("loadtest")
else
  store = datastore("loadtest", ds_config)
end

init_elapsed = timer() - init_start

key_count = len(store.keys())
enc_label = encrypted ? "encrypted" : "unencrypted"
wal_label = wal != false ? "WAL-backed" : "in-memory"
print("✓ Datastore loaded in {{floor(init_elapsed * 1000)}}ms ({{key_count}} objects, {{enc_label}}, {{wal_label}})")
print("")

// Warmup: single get
_ = store.get("rec_0")

// Benchmark 1: Sequential GET operations
bench_size = min(100000, key_count)
print("Benchmark 1: Sequential GET ({{bench_size}} operations)")
start = timer()
for i = 0, bench_size - 1 do
  idx = i % key_count
  _ = store.get("rec_" + idx)
end
elapsed = timer() - start
rate = bench_size / elapsed
print("  {{floor(elapsed * 1000)}}ms ({{floor(rate)}}/sec)")
print("")

// Benchmark 2: Sequential SET (update random objects)
bench_size = min(10000, key_count)
print("Benchmark 2: Sequential SET ({{bench_size}} updates)")
start = timer()
for i = 0, bench_size - 1 do
  idx = i % key_count
  id = "rec_" + idx
  obj = store.get(id)
  obj.value = obj.value + 1
  store.set(id, obj)
end
elapsed = timer() - start
rate = bench_size / elapsed
print("  {{floor(elapsed * 1000)}}ms ({{floor(rate)}}/sec)")
print("")

// Benchmark 3: SELECT with predicate (find objects where value > threshold)
threshold = size * 0.5
print("Benchmark 3: SELECT by predicate (value > {{threshold}})")
start = timer()
results = store.select(function(k, v)
  if starts_with(k, "rec_") and v.value > threshold then return v end
end)
elapsed = timer() - start
count = len(results)
print("  {{floor(elapsed * 1000)}}ms - found {{count}} results")
print("")

// Benchmark 4: COUNT with predicate
print("Benchmark 4: COUNT by predicate (value > {{threshold}})")
start = timer()
count = store.count(function(k, v)
  return starts_with(k, "rec_") and v.value > threshold
end)
elapsed = timer() - start
print("  {{floor(elapsed * 1000)}}ms - count={{count}}")
print("")

// Benchmark 5: SELECT with max limit (sample first 100 matches)
print("Benchmark 5: SELECT by predicate with max=100 (tags contain 'tag_5')")
start = timer()
results = store.select(function(k, v)
  if not starts_with(k, "rec_") then return nil end
  for tag in v.tags do
    if tag == "tag_5" then return v end
  end
end, max = 100)
elapsed = timer() - start
count = len(results)
print("  {{floor(elapsed * 1000)}}ms - found {{count}} results")
print("")

// Benchmark 6: Atomic increment on a counter
bench_size = min(100000, key_count)
print("Benchmark 6: Atomic INCREMENT ({{bench_size}} increments)")
store.set("counter", 0)
start = timer()
for i = 0, bench_size - 1 do
  store.increment("counter", 1)
end
elapsed = timer() - start
rate = bench_size / elapsed
final_val = store.get("counter")
print("  {{floor(elapsed * 1000)}}ms ({{floor(rate)}}/sec) - final={{final_val}}")
print("")

// Benchmark 7: Atomic UPDATE (partial deep-merge on a multi-key object)
bench_size = min(10000, key_count)
print("Benchmark 7: Atomic UPDATE ({{bench_size}} partial updates, 2 of 6 keys)")
start = timer()
for i = 0, bench_size - 1 do
  idx = i % key_count
  id = "rec_" + idx
  store.update(id, {value = i, data = "updated_" + i})
end
elapsed = timer() - start
rate = bench_size / elapsed
print("  {{floor(elapsed * 1000)}}ms ({{floor(rate)}}/sec)")
print("")

// Benchmark 8/9: Queue throughput - push then drain a single key.
//
// This is the operation the datastore's coordination story rests on
// (push/shift/pop_wait between spawned workers) and it is the one most
// sensitive to the WAL's record format: a log that stores resulting state
// rewrites the whole array on every operation, making a queue quadratic on
// disk. Kept modest by default so it stays runnable against older builds where
// that quadratic cost is real.
queue_size = config.queue_size or 2000
queue_item = {id = 0, payload = "xxxxxxxxxxxxxxxxxxxx"}

store.delete("bench_queue")

wal_before = 0
if wal != false and file_exists(wal_path) then
  wal_before = len(load_binary(wal_path))
end

print("Benchmark 8: Queue PUSH ({{queue_size}} items)")
start = timer()
for i = 0, queue_size - 1 do
  store.push("bench_queue", {id = i, payload = "xxxxxxxxxxxxxxxxxxxx"})
end
elapsed = timer() - start
rate = queue_size / elapsed
print("  {{floor(elapsed * 1000)}}ms ({{floor(rate)}}/sec)")
print("")

print("Benchmark 9: Queue SHIFT ({{queue_size}} items drained)")
start = timer()
for i = 0, queue_size - 1 do
  _ = store.shift("bench_queue")
end
elapsed = timer() - start
rate = queue_size / elapsed
print("  {{floor(elapsed * 1000)}}ms ({{floor(rate)}}/sec)")

if wal != false then
  wal_after = len(load_binary(wal_path))
  grew = wal_after - wal_before
  ops = queue_size * 2
  if grew < 0 then
    print("  WAL bytes: not measurable (a snapshot truncated the log mid-run)")
  else
    per_op = grew / ops
    print("  WAL grew {{floor(grew / 1024)}}KB for {{ops}} queue operations ({{floor(per_op)}} bytes/op)")
  end
end
print("")

print("✓ All benchmarks complete")
